# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# HF_TOKEN: Required for Hugging Face Whisper Large v3 (openai/whisper-large-v3) speech transcription.
# Read only by the backend server; never exposed to the client or browser.
# Get your User Access Token from https://huggingface.co/settings/tokens
HF_TOKEN=""

# VITE_EXPORT_SERVER_URL: Optional external backend URL for heavy video rendering (e.g. Render.com / VPS)
# Leave blank to use the internal /api/export-video route
VITE_EXPORT_SERVER_URL=""

